{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qm.example/sunny-mod-manifest-v2.schema.json",
  "title": "Sunny Mod Loader Metadata Manifest v2",
  "description": "Package metadata and user-facing settings. All story and resource behavior belongs in story/*.txt or story/*.sunny flow files.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "version", "compatibility"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+$"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "authors": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "settings": {
      "description": "User-configurable package settings exposed by the loader.",
      "type": "array",
      "items": { "$ref": "#/$defs/boolSetting" }
    }
  },
  "$defs": {
    "entryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,62}[A-Za-z0-9])?$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loaderApi"],
      "properties": {
        "loaderApi": { "const": 2 },
        "gameBuilds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "priority": { "type": "integer", "default": 0 }
      }
    },
    "boolSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "label": { "type": "string" },
        "defaultValue": { "type": "boolean", "default": false }
      }
    }
  }
}
